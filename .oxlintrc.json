{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react"],
	"ignorePatterns": ["node_modules", "dist", "out", "coverage", ".nyc_output", ".vscode", ".env", ".eco"],
	"rules": {
		"no-param-reassign": "error",
		"default-param-last": "error",
		"no-else-return": "error",
		"no-restricted-properties": [
			"error",
			{
				"property": "NODE_ENV",
				"message": "Use the centralized runtime mode helpers from @ecopages/core."
			}
		],
		"no-explicit-any": "off",
		"no-empty-interface": "off",
		"no-inferrable-types": "off",
		"react/jsx-key": "off",
		"complexity": ["error", { "max": 15 }],
		"no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_"
			}
		]
	},
	"overrides": [
		{
			"files": ["packages/core/src/env.ts", "packages/core/src/browser-env.ts"],
			"rules": {
				"no-restricted-properties": "off"
			}
		},
		{
			"files": ["playground/kitchen-sink/bench/**"],
			"rules": {
				"no-restricted-properties": "off"
			}
		},
		{
			"files": ["packages/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{ "name": "node:fs", "message": "Use fileSystem from @ecopages/file-system." },
							{ "name": "node:fs/promises", "message": "Use fileSystem from @ecopages/file-system." },
							{ "name": "fs", "message": "Use fileSystem from @ecopages/file-system." },
							{ "name": "fs/promises", "message": "Use fileSystem from @ecopages/file-system." },
							{
								"name": "node:path",
								"message": "Use path from @ecopages/file-system/path, which keeps every path in forward slashes."
							},
							{
								"name": "path",
								"message": "Use path from @ecopages/file-system/path, which keeps every path in forward slashes."
							},
							{
								"name": "node:url",
								"importNames": ["fileURLToPath", "pathToFileURL"],
								"message": "Use path.fromFileUrl or path.toFileUrl from @ecopages/file-system/path, which keep every path in forward slashes."
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"packages/file-system/**",
				"packages/**/*.test.*",
				"packages/**/*.test-helpers.ts",
				"packages/**/test/**",
				"packages/**/__tests__/**",
				"packages/**/__fixtures__/**"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "node:path",
								"message": "Use path from @ecopages/file-system/path, which keeps every path in forward slashes."
							},
							{
								"name": "path",
								"message": "Use path from @ecopages/file-system/path, which keeps every path in forward slashes."
							},
							{
								"name": "node:url",
								"importNames": ["fileURLToPath", "pathToFileURL"],
								"message": "Use path.fromFileUrl or path.toFileUrl from @ecopages/file-system/path, which keep every path in forward slashes."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/file-system/src/path.ts", "packages/codemod/**"],
			"rules": {
				"no-restricted-imports": "off"
			}
		}
	]
}
