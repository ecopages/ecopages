{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react"],
	"ignorePatterns": ["node_modules", "dist", "out", "coverage", ".nyc_output", ".vscode", ".env", ".eco"],
	"rules": {
		"no-param-reassign": "error",
		"default-param-last": "error",
		"no-else-return": "error",
		"no-explicit-any": "off",
		"no-empty-interface": "off",
		"no-inferrable-types": "off",
		"react/jsx-key": "off",
		"complexity": [
			"error",
			{
				"max": 15
			}
		]
	},
	"overrides": [
		{
			"files": [
				"**/*.{test,spec}.*",
				"**/*.test.browser.ts",
				"**/*.test.e2e.ts",
				"**/test/**",
				"**/type-tests/**"
			],
			"rules": {
				"complexity": "off"
			}
		},
		{
			"files": [],
			"rules": {
				"complexity": "off"
			}
		}
	]
}
