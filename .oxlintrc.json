{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react"],
	"ignorePatterns": ["node_modules", "dist", "out", "coverage", ".nyc_output", ".vscode", ".env", ".eco"],
	"rules": {
		"no-param-reassign": "error",
		"default-param-last": "error",
		"no-else-return": "error",
		"no-explicit-any": "off",
		"no-empty-interface": "off",
		"no-inferrable-types": "off",
		"react/jsx-key": "off",
		"complexity": [
			"error",
			{
				"max": 15
			}
		]
	},
	"overrides": [
		{
			"files": [
				"**/*.{test,spec}.*",
				"**/*.test.browser.ts",
				"**/*.test.e2e.ts",
				"**/test/**",
				"**/type-tests/**"
			],
			"rules": {
				"complexity": "off"
			}
		},
		{
			"files": [
				"apps/docs/scripts/generate-llm-docs.ts",
				"e2e/scripts/playwright/run-isolated-app.mjs",
				"packages/codemod/src/transforms/migrate-to-eco-component.ts",
				"packages/codemod/src/transforms/migrate-to-eco-page.ts",
				"packages/dev-toolbar/src/apps/a11y/run-a11y-checks.ts",
				"packages/ecopages/bin/git-template-source.js",
				"packages/ecopages/bin/init.js",
				"packages/integrations/lit/src/lit-ssr-lazy-preloader.ts",
				"packages/integrations/react/src/client-graph/ast-transform.ts",
				"packages/integrations/react/src/client-graph/boundary-plugin.ts",
				"packages/integrations/react/src/client-graph/reachability-analyzer.ts",
				"packages/integrations/react/src/hmr/hmr-strategy.ts",
				"packages/integrations/react/src/hydration/browser/page-hydration.ts",
				"packages/integrations/react/src/hydration/hydration-script-compiler.ts",
				"packages/processors/postcss-processor/src/plugin.ts",
				"packages/vite-plugin/src/ecopages-hot-update.ts",
				"playground/kitchen-sink/bench/startup/run.mjs",
				"scripts/debug-app.bench.mjs",
				"templates/llm-wiki/app/src/lib/wiki/links.ts",
				"templates/llm-wiki/app/src/lib/wiki/lint.ts"
			],
			"rules": {
				"complexity": "off"
			}
		}
	]
}
