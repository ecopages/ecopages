+
+## 9) Key Files
+
+- `packages/core/src/adapters/shared/server-adapter.ts`
+- `packages/core/src/adapters/shared/server-route-handler.ts`
+- `packages/core/src/adapters/shared/fs-server-response-matcher.ts`
