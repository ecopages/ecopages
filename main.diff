+@import 'tailwindcss';
+@import 'ecopages/css/view-transitions.css';
+
+@theme {
+	--color-surface-50: oklch(0.98 0 0);
+	--color-surface-100: oklch(0.95 0 0);
+	--color-surface-200: oklch(0.9 0 0);
+	--color-surface-300: oklch(0.8 0 0);
+	--color-surface-400: oklch(0.6 0 0);
+	--color-surface-500: oklch(0.5 0 0);
+	--color-surface-600: oklch(0.4 0 0);
+	--color-surface-700: oklch(0.3 0 0);
+	--color-surface-800: oklch(0.2 0 0);
+	--color-surface-900: oklch(0.12 0 0);
+	--color-surface-950: oklch(0.08 0 0);
+
+	--color-accent: oklch(0.7 0.15 220);
+
+	--color-white: oklch(1 0 0);
+	--color-black: oklch(0 0 0);
+
+	--color-background: var(--color-surface-950);
+	--color-on-background: var(--color-surface-100);
+	--color-muted: var(--color-surface-400);
+
+	--color-background-accent: var(--color-surface-900);
+	--color-on-background-accent: var(--color-surface-100);
+	--color-border: var(--theme-border, var(--color-surface-100));
+
+	--font-display: 'JetBrains Mono', 'IBM Plex Sans', 'Avenir Next', 'Segoe UI', sans-serif;
+	--font-body: 'JetBrains Mono', 'IBM Plex Sans', 'Avenir Next', 'Segoe UI', sans-serif;
+	--font-mono: 'JetBrains Mono', 'IBM Plex Sans', ui-monospace, monospace;
+}
+
+@custom-variant dark (&:where([data-theme="dark"], [data-theme="dark"] *));
+
+body {
+	@apply bg-background min-h-dvh flex flex-col antialiased transition-colors duration-200;
+	font-family: var(--font-body);
+}
+
+:root {
+	color-scheme: light;
+	--color-background: var(--color-white);
+	--color-on-background: var(--color-surface-900);
+	--color-muted: var(--color-surface-500);
+
+	--color-background-accent: var(--color-surface-50);
+	--color-on-background-accent: var(--color-surface-900);
+	--color-border: var(--color-surface-100);
+}
+
+[data-theme='dark'] {
+	color-scheme: dark;
+	--color-background: var(--color-surface-950);
+	--color-on-background: var(--color-surface-100);
+
+	--color-background-accent: var(--color-surface-900);
+	--color-on-background-accent: var(--color-surface-100);
+	--color-muted: var(--color-surface-400);
+	--color-border: var(--color-surface-800);
+}
+
+@layer components {
+	.button,
+	.badge {
+		@apply rounded-md;
+	}
+
+	.button {
+		@apply border border-border bg-background px-3 py-1.5 transition hover:border-sky-300 hover:text-sky-600 outline-none flex items-center justify-center text-sm;
+
+		&--primary {
+			@apply bg-sky-600 px-5 py-3 font-semibold text-white transition hover:bg-sky-500 hover:text-white border-transparent hover:border-transparent rounded-md;
+		}
+
+		&--secondary {
+			@apply border border-border px-5 py-3 font-semibold text-on-background transition hover:border-sky-300 hover:text-sky-600 rounded-md;
+		}
+	}
+
+	.badge {
+		@apply border border-border bg-background-accent px-3 py-1 text-xs text-on-background-accent;
+
+		&--mono {
+			@apply font-mono;
+		}
+	}
+
+	.card {
+		@apply rounded-md border border-border bg-background p-5 transition;
+
+		&--hoverable {
+			@apply hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-[0_8px_30px_rgba(14,165,233,0.06)];
+		}
+
+		&--accent {
+			@apply rounded-md border border-border bg-background-accent p-4 transition hover:border-sky-300;
+		}
+	}
+}
