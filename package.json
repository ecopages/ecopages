{
	"name": "@ecopages/ecopages",
	"private": true,
	"version": "0.2.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev:docs": "pnpm --filter @ecopages/docs run dev",
		"build:docs": "pnpm --filter @ecopages/docs run build",
		"build:npm": "node scripts/build-npm-packages.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version && node scripts/sync-root-version.ts",
		"release": "node scripts/build-npm-packages.ts --stamp-publish-directory && changeset publish",
		"template:local-npm": "node scripts/run-template-with-local-npm.ts",
		"start:docs": "pnpm --filter @ecopages/docs run start",
		"preview:docs": "pnpm --filter @ecopages/docs run preview",
		"clean": "clear && pnpx npkill -D -y && rm -rf pnpm-lock.yaml node_modules .templates && pnpm install",
		"check:portability": "node scripts/check-portability.ts",
		"check:templates": "node --experimental-strip-types scripts/check-templates.ts",
		"sync:template-skills": "node --experimental-strip-types scripts/sync-template-agent-skills.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint . --fix",
		"lint-staged": "lint-staged",
		"commit": "better-commits",
		"prepare:husky": "husky",
		"test:all": "pnpm run test:vitest && pnpm run test:e2e",
		"test:pre-commit": "pnpm run test:vitest && pnpm run lint && pnpm run lint-staged && pnpm run typecheck && pnpm run typecheck:e2e",
		"test:ci": "pnpm run test:ci:fast",
		"test:ci:fast": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run typecheck:e2e && pnpm run test:vitest",
		"test:vitest": "vitest run --project shared-core --project browser --project docs --project docs-starter --project llm-wiki --browser.headless",
		"test:bench": "ECOPAGES_BENCH=1 pnpm --filter @ecopages/kitchen-sink exec tsx bench/run.mts",
		"test:bench:baseline": "pnpm --filter @ecopages/kitchen-sink exec tsx bench/scripts/consolidate-baseline.ts",
		"test:bench:compare": "ECOPAGES_BENCH=1 pnpm --filter @ecopages/kitchen-sink exec tsx bench/run.mts && pnpm --filter @ecopages/kitchen-sink exec tsx bench/scripts/compare-baseline.ts",
		"test:bench:startup": "ECOPAGES_BENCH=1 node playground/kitchen-sink/bench/startup/run.mjs",
		"test:bench:hmr": "ECOPAGES_BENCH=1 node --experimental-strip-types playground/kitchen-sink/bench/hmr-e2e-bench.mts",
		"test:bench:docs": "node scripts/benchmark-docs-dev.mjs",
		"test:bench:startup:baseline": "pnpm --filter @ecopages/kitchen-sink exec tsx bench/startup/consolidate-baseline.ts",
		"test:bench:startup:compare": "ECOPAGES_BENCH=1 node playground/kitchen-sink/bench/startup/run.mjs && pnpm --filter @ecopages/kitchen-sink exec tsx bench/startup/compare-baseline.ts",
		"test:e2e": "playwright test",
		"test:e2e:pr": "ECOPAGES_E2E_PR=true playwright test --project=browser-router-e2e --project=core-hmr-dev-e2e --project=core-hmr-postcss-dev-e2e --project=cross-integration-dev-e2e --project=cross-integration-bun-parity-e2e --project=cross-integration-bun-build-e2e --project=cross-integration-hmr-node-e2e --project=cross-integration-preview-e2e --project=html-pages-e2e --project=html-pages-dev-e2e --project=react-router-runtime-modules-e2e --project=react-router-persist-layouts-dev-e2e",
		"test:e2e:docs": "playwright test --config=playwright.docs.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:gate": "pnpm run test:vitest && playwright test --project=cross-integration-dev-e2e --grep='@stress'",
		"typecheck": "pnpm run check:portability && pnpm --filter '*' --filter '!@ecopages/ecopages' run typecheck",
		"typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.2",
		"@ecopages/logger": "^0.2.3",
		"@playwright/test": "^1.60.0",
		"@types/node": "^24.12.4",
		"@vitest/browser": "^4.1.6",
		"@vitest/browser-playwright": "^4.1.6",
		"better-commits": "^1.23.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"mitata": "^1.0.34",
		"oxlint": "^1.64.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.6"
	},
	"module": "src/index.js",
	"repository": "https://github.com/ecopages/ecopages.git",
	"type": "module",
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
