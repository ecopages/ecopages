{
	"name": "@ecopages/codemod",
	"version": "0.0.1",
	"description": "Codemods for migrating ecopages to latest patterns",
	"type": "module",
	"private": true,
	"main": "src/transforms/index.ts",
	"scripts": {
		"transform:data-hooks": "jscodeshift -t src/transforms/migrate-data-hooks.ts --parser tsx",
		"transform:pages": "jscodeshift -t src/transforms/migrate-to-eco-page.ts --parser tsx",
		"transform:components": "jscodeshift -t src/transforms/migrate-to-eco-component.ts --parser tsx",
		"transform:core-entrypoints": "jscodeshift -t src/transforms/migrate-core-entrypoints.ts --parser tsx",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/jscodeshift": "^17.3.0",
		"jscodeshift": "^17.3.0",
		"vitest": "^4.1.6"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	}
}
