{
	"name": "@ecopages/core",
	"version": "0.2.0-beta.2",
	"description": "Core package for Ecopages",
	"keywords": [
		"ecopages",
		"core",
		"ssg"
	],
	"license": "MIT",
	"main": "./src/index.ts",
	"type": "module",
	"files": [
		"src"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/ecopages.git",
		"directory": "packages/core"
	},
	"scripts": {
		"typecheck": "bunx tsc --noEmit",
		"release:jsr": "bunx jsr publish"
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*",
		"@ecopages/logger": "^0.2.3",
		"@ecopages/scripts-injector": "^0.1.5",
		"@oxc-project/runtime": "0.134.0",
		"@worker-tools/html-rewriter": "0.1.0-pre.19",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.0",
		"ghtml": "^4.0.2",
		"oxc-parser": "^0.124.0",
		"rolldown": "^1.1.0",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/ws": "^8.18.1",
		"arktype": "^2.2.0",
		"tailwindcss": "^3.4.19",
		"valibot": "^1.4.0",
		"zod": "^4.4.3"
	},
	"exports": {
		".": {
			"browser": "./src/index.browser.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./create-app": {
			"import": "./src/adapters/create-app.ts",
			"types": "./src/adapters/create-app.ts",
			"default": "./src/adapters/create-app.ts"
		},
		"./route-renderer/integration-renderer": {
			"types": "./src/route-renderer/orchestration/integration-renderer.ts",
			"default": "./src/route-renderer/orchestration/integration-renderer.ts"
		},
		"./route-renderer/component-render-context": {
			"import": "./src/route-renderer/orchestration/component-render-context.ts",
			"types": "./src/route-renderer/orchestration/component-render-context.ts",
			"default": "./src/route-renderer/orchestration/component-render-context.ts"
		},
		"./router/navigation-coordinator": {
			"types": "./src/router/client/navigation-coordinator.ts",
			"default": "./src/router/client/navigation-coordinator.ts"
		},
		"./router/link-intent": {
			"types": "./src/router/client/link-intent.ts",
			"default": "./src/router/client/link-intent.ts"
		},
		"./eco": {
			"browser": "./src/eco/eco.browser.ts",
			"types": "./src/eco/eco.ts",
			"default": "./src/eco/eco.ts"
		},
		"./declarations": {
			"types": "./src/declarations.d.ts"
		},
		"./env": {
			"types": "./src/env.d.ts"
		},
		"./config-builder": {
			"types": "./src/config/config-builder.ts",
			"default": "./src/config/config-builder.ts"
		},
		"./constants": {
			"types": "./src/config/constants.ts",
			"default": "./src/config/constants.ts"
		},
		"./bun": {
			"types": "./src/adapters/bun/index.ts",
			"default": "./src/adapters/bun/index.ts"
		},
		"./hmr/hmr-strategy": {
			"types": "./src/hmr/hmr-strategy.ts",
			"default": "./src/hmr/hmr-strategy.ts"
		},
		"./hmr/client/hmr-runtime": {
			"types": "./src/hmr/client/hmr-runtime.ts",
			"default": "./src/hmr/client/hmr-runtime.ts"
		},
		"./dev/host-runtime": {
			"types": "./src/dev/host-runtime.ts",
			"default": "./src/dev/host-runtime.ts"
		},
		"./services/asset-processing-service": {
			"types": "./src/services/assets/asset-processing-service/index.ts",
			"default": "./src/services/assets/asset-processing-service/index.ts"
		},
		"./plugins/processor": {
			"types": "./src/plugins/processor.ts",
			"default": "./src/plugins/processor.ts"
		},
		"./plugins/integration-plugin": {
			"types": "./src/plugins/integration-plugin.ts",
			"default": "./src/plugins/integration-plugin.ts"
		},
		"./plugins/source-transform": {
			"types": "./src/plugins/source-transform.ts",
			"default": "./src/plugins/source-transform.ts"
		},
		"./build/build-types": {
			"types": "./src/build/build-types.ts",
			"default": "./src/build/build-types.ts"
		},
		"./build/build-adapter": {
			"types": "./src/build/build-adapter.ts",
			"default": "./src/build/build-adapter.ts"
		},
		"./build/runtime-build-output-normalizer": {
			"types": "./src/build/runtime-build-output-normalizer.ts",
			"default": "./src/build/runtime-build-output-normalizer.ts"
		},
		"./build/browser-runtime-manifest": {
			"types": "./src/build/browser-runtime-manifest.ts",
			"default": "./src/build/browser-runtime-manifest.ts"
		},
		"./build/browser-runtime-plugin": {
			"types": "./src/build/browser-runtime-plugin.ts",
			"default": "./src/build/browser-runtime-plugin.ts"
		},
		"./cache": {
			"types": "./src/cache/index.ts",
			"default": "./src/cache/index.ts"
		},
		"./plugins/foreign-jsx-override-plugin": {
			"types": "./src/plugins/foreign-jsx-override-plugin.ts",
			"default": "./src/plugins/foreign-jsx-override-plugin.ts"
		},
		"./html": {
			"import": "./src/utils/html.ts",
			"require": "./src/utils/html.ts"
		},
		"./hash": {
			"import": "./src/utils/hash.ts",
			"require": "./src/utils/hash.ts"
		},
		"./utils/hash": {
			"import": "./src/utils/hash.ts",
			"require": "./src/utils/hash.ts"
		},
		"./utils/resolve-entry-file": {
			"import": "./src/utils/resolve-entry-file.ts",
			"types": "./src/utils/resolve-entry-file.ts",
			"default": "./src/utils/resolve-entry-file.ts"
		},
		"./errors": {
			"types": "./src/errors/index.ts",
			"default": "./src/errors/index.ts"
		},
		"./integrations/ghtml": {
			"types": "./src/integrations/ghtml/ghtml.plugin.ts",
			"default": "./src/integrations/ghtml/ghtml.plugin.ts"
		}
	}
}
