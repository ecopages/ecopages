{
	"name": "@ecopages/core",
	"version": "0.5.0",
	"description": "Core package for Ecopages",
	"keywords": [
		"ecopages",
		"core",
		"ssg"
	],
	"license": "MIT",
	"main": "./src/index.ts",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/core"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@ecopages/file-system": "workspace:*",
		"@ecopages/logger": "^0.2.3",
		"@ecopages/scripts-injector": "^0.1.5",
		"@jridgewell/remapping": "^2.3.5",
		"@standard-schema/spec": "^1.1.0",
		"@standard-schema/utils": "^0.3.0",
		"magic-string": "^1.4.3",
		"oxc-parser": "^0.141.0",
		"oxc-resolver": "^11.24.2",
		"rolldown": "^1.1.0",
		"ws": "^8.20.1"
	},
	"devDependencies": {
		"@ecopages/dev-toolbar": "workspace:*",
		"@ecopages/testing": "workspace:*",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@tanstack/react-query": "^5.90.2",
		"@types/ws": "^8.18.1",
		"arktype": "^2.2.0",
		"tailwindcss": "^3.4.19",
		"valibot": "^1.4.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@ecopages/dev-toolbar": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@ecopages/dev-toolbar": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"browser": "./src/index.browser.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./create-app": {
			"import": "./src/adapters/create-app.ts",
			"types": "./src/adapters/create-app.ts",
			"default": "./src/adapters/create-app.ts"
		},
		"./integration": {
			"import": "./src/integration.ts",
			"types": "./src/integration.ts",
			"default": "./src/integration.ts"
		},
		"./processor": {
			"import": "./src/processor.ts",
			"types": "./src/processor.ts",
			"default": "./src/processor.ts"
		},
		"./build": {
			"import": "./src/build.ts",
			"types": "./src/build.ts",
			"default": "./src/build.ts"
		},
		"./build/contracts": {
			"import": "./src/build/contracts.ts",
			"types": "./src/build/contracts.ts",
			"default": "./src/build/contracts.ts"
		},
		"./client": {
			"import": "./src/client.ts",
			"types": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./declarations": {
			"types": "./src/declarations.d.ts"
		},
		"./env": {
			"types": "./src/env.d.ts"
		},
		"./config": {
			"types": "./src/config/index.ts",
			"default": "./src/config/index.ts"
		},
		"./config/write-types": {
			"types": "./src/config/write-types.ts",
			"default": "./src/config/write-types.ts"
		},
		"./hmr/client/hmr-runtime": {
			"types": "./src/hmr/client/hmr-runtime.ts",
			"default": "./src/hmr/client/hmr-runtime.ts"
		},
		"./errors": {
			"types": "./src/errors/index.ts",
			"default": "./src/errors/index.ts"
		},
		"./view-reference": {
			"import": "./src/build/server/view-reference.ts",
			"types": "./src/build/server/view-reference.ts",
			"default": "./src/build/server/view-reference.ts"
		}
	}
}
