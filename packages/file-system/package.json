{
	"name": "@ecopages/file-system",
	"version": "0.2.0",
	"description": "Node file system utilities for Ecopages",
	"keywords": [
		"ecopages",
		"fs",
		"file-system",
		"node"
	],
	"license": "MIT",
	"main": "./src/index.ts",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/file-system"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run --root ../.. --project shared-core packages/file-system",
		"benchmark": "node --experimental-strip-types test/benchmark.ts"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"types": "./src/types.ts"
		},
		"./node": {
			"import": "./src/adapters/node.ts",
			"types": "./src/adapters/node.ts"
		}
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"mitata": "^1.0.34"
	},
	"dependencies": {
		"chokidar": "^5.0.0"
	}
}
