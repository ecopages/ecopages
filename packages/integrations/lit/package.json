{
	"name": "@ecopages/lit",
	"version": "0.6.0",
	"description": "Ecopages lit integration",
	"keywords": [
		"ecopages",
		"lit",
		"plugin"
	],
	"license": "MIT",
	"engines": {
		"node": "^24.22.0 || >=26.0.0"
	},
	"main": "./src/lit.plugin.ts",
	"types": "./src/lit.plugin.ts",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/lit.plugin.ts",
			"types": "./src/lit.plugin.ts"
		},
		"./styled-mixin": {
			"default": "./src/styled-mixin.ts",
			"types": "./src/styled-mixin.ts"
		},
		"./hydrate-support": {
			"default": "./src/lit-hydrate-support.ts",
			"types": "./src/lit-hydrate-support.ts"
		},
		"./static-render-worker": {
			"default": "./src/lit-static-render-worker.ts",
			"types": "./src/lit-static-render-worker.ts"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/integrations/lit"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*"
	},
	"devDependencies": {
		"@ecopages/core": "workspace:*",
		"@ecopages/testing": "workspace:*"
	},
	"peerDependencies": {
		"@ecopages/core": "workspace:*",
		"@lit-labs/ssr": "^3.3.0",
		"@lit-labs/ssr-client": "^1.1.7",
		"lit": "^3.2.1"
	}
}
