{
	"name": "@ecopages/react",
	"version": "0.2.0-beta.18",
	"description": "React integration for Ecopages",
	"keywords": [
		"ecopages",
		"react",
		"plugin"
	],
	"license": "MIT",
	"main": "./src/react.plugin.ts",
	"types": "./src/react.plugin.ts",
	"type": "module",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/react.plugin.ts",
			"types": "./src/react.plugin.ts"
		},
		"./eco-embed": {
			"default": "./src/eco-embed.tsx",
			"types": "./src/eco-embed.tsx"
		},
		"./declarations": {
			"types": "./src/declarations.d.ts"
		},
		"./utils/dynamic": "./src/utils/dynamic.ts",
		"./utils/client-only": "./src/utils/client-only.ts",
		"./runtime/use-sync-external-store-with-selector": "./src/runtime/use-sync-external-store-with-selector.ts",
		"./router-adapter": "./src/router-adapter.ts",
		"./layout-compose": "./src/layout-compose.ts",
		"./serialize-page-data-script": "./src/serialize-page-data-script.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/integrations/react"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"release:jsr": "node ../../../scripts/prepare-jsr-publish.ts . --publish"
	},
	"peerDependencies": {
		"@ecopages/core": "workspace:*",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"react": "^19",
		"react-dom": "^19"
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*",
		"@ecopages/logger": "^0.2.3",
		"@ecopages/mdx": "workspace:*",
		"@mdx-js/mdx": "^3.1.1",
		"oxc-parser": "^0.124.0",
		"oxc-transform": "^0.124.0",
		"source-map": "^0.7.6",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@ecopages/core": "workspace:*",
		"@ecopages/testing": "workspace:*"
	}
}
