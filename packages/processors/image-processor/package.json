{
	"name": "@ecopages/image-processor",
	"version": "0.2.0-rc.5",
	"description": "Image processor, transform and optimize images for web",
	"keywords": [
		"image",
		"processor"
	],
	"license": "MIT",
	"main": "./src/image-processor.ts",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/processors/image-processor"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@ecopages/core": "workspace:*",
		"@ecopages/jsx": "^0.3.0-rc.2"
	},
	"peerDependenciesMeta": {
		"@ecopages/jsx": {
			"optional": true
		}
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*",
		"@ecopages/logger": "^0.2.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@ecopages/core": "workspace:*",
		"@ecopages/jsx": "^0.3.0-rc.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3"
	},
	"exports": {
		".": {
			"default": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./types": {
			"types": "./src/image-types.d.ts"
		},
		"./component/html": {
			"default": "./src/component/html.ts",
			"types": "./src/component/html.ts"
		},
		"./component/jsx": {
			"default": "./src/component/jsx.ts",
			"types": "./src/component/jsx.ts"
		},
		"./component/react": {
			"default": "./src/component/react.ts",
			"types": "./src/component/react.ts"
		}
	}
