{
	"name": "@ecopages/lightningcss-processor",
	"version": "0.6.0",
	"description": "Lightning CSS stylesheet processor for Ecopages: bundles @import, lowers for browser targets and minifies",
	"keywords": [
		"lightningcss",
		"processor",
		"css"
	],
	"license": "MIT",
	"main": "./src/index.ts",
	"type": "module",
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ecopages/ecopages.git",
		"directory": "packages/processors/lightningcss-processor"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*",
		"@ecopages/logger": "^0.2.3",
		"browserslist": "^4.28.2",
		"lightningcss": "1.33.0"
	},
	"peerDependencies": {
		"@ecopages/core": "workspace:*"
	},
	"devDependencies": {
		"@ecopages/core": "workspace:*"
	},
	"exports": {
		".": {
			"default": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./plugin": {
			"default": "./src/plugin.ts",
			"types": "./src/plugin.ts"
		}
	}
}
