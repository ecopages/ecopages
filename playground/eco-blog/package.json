{
	"name": "@ecopages/eco-blog",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "ecopages dev",
		"build": "ecopages build",
		"start": "pnpm run build && ecopages start",
		"preview": "ecopages preview",
		"typecheck": "ecopages types && tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx src/lib/seed.ts",
		"db:setup": "pnpm run db:migrate && pnpm run db:seed",
		"db:reset": "tsx scripts/reset.ts"
	},
	"devDependencies": {
		"@ecopages/core": "workspace:*",
		"@ecopages/image-processor": "workspace:*",
		"@ecopages/kitajs": "workspace:*",
		"@ecopages/mdx": "workspace:*",
		"@ecopages/postcss-processor": "workspace:*",
		"@ecopages/radiant": "^0.4.0",
		"@faker-js/faker": "^10.4.0",
		"@kitajs/html": "^4.2.13",
		"@tailwindcss/postcss": "^4.3.3",
		"drizzle-kit": "^0.31.11",
		"ecopages": "workspace:*",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.22.3"
	},
	"dependencies": {
		"@ecopages/file-system": "workspace:*",
		"@libsql/client": "^0.17.4",
		"@mdx-js/mdx": "^3.1.1",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-image": "^3.23.4",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"better-auth": "^1.7.10",
		"drizzle-orm": "^0.45.2",
		"tiptap-markdown": "^0.9.0",
		"zod": "^4.6.7"
	}
}
