{
	"name": "@ecopages/template-docs-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "pnpm run sync:font-assets && pnpm run generate:llms && ecopages preview",
		"generate:llms": "tsx scripts/generate-llm-docs.ts",
		"sync:font-assets": "node ./scripts/copy-font-assets.mjs",
		"dev": "pnpm run sync:font-assets && pnpm run generate:llms && ecopages dev",
		"build": "pnpm run sync:font-assets && pnpm run generate:llms && ecopages build",
		"preview": "pnpm run sync:font-assets && ecopages preview",
		"test": "vitest run",
		"typecheck": "ecopages types && tsc --noEmit"
	},
	"devDependencies": {
		"@ecopages/browser-router": "workspace:*",
		"@ecopages/content-processor": "workspace:*",
		"@ecopages/core": "workspace:*",
		"@ecopages/ecopages-jsx": "workspace:*",
		"@ecopages/jsx": "^0.9.0",
		"@ecopages/lightningcss-processor": "workspace:*",
		"@ecopages/mdx": "workspace:*",
		"@ecopages/radiant": "^0.9.0",
		"@ecopages/radiant-ui": "^0.4.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@mdx-js/mdx": "^3.1.1",
		"@rehype-pretty/transformers": "^0.13.2",
		"@tailwindcss/node": "^4.0.0",
		"@tailwindcss/oxide": "^4.0.0",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"ecopages": "workspace:*",
		"mdast-util-from-markdown": "^2.0.3",
		"pele": "1.13.0",
		"rehype-pretty-code": "^0.14.3",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.23.0",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.22.3",
		"unified": "^11.0.5",
		"vfile": "^6.0.3",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
