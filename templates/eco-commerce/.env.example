ECOPAGES_BASE_URL=http://localhost:3000

# Signs the cart cookie. Required in production, at least 32 characters.
CART_SECRET=

# libSQL database: a local file (default) or a remote database such as Turso.
# DATABASE_URL=file:.data/catalog.db
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Catalog preset: small, medium (default) or large. The next start regenerates the catalog.
CATALOG_SIZE=medium

# How much the build renders ahead; the rest renders on first request.
# PREBUILT_PRODUCTS_PER_SUBCATEGORY=4
# PREBUILT_LISTING_PAGES=2

# Enables POST /api/revalidate when set.
# REVALIDATE_TOKEN=
