ECOPAGES_BASE_URL=http://localhost:3000

# Signs the cart cookie. Required in production, at least 32 characters.
CART_SECRET=

# Catalog preset: small (default), medium or large. The next start regenerates the database.
CATALOG_SIZE=small

# Database file, relative to the app folder.
# CATALOG_DB_PATH=.data/catalog.db

# Enables POST /api/revalidate when set.
# REVALIDATE_TOKEN=
