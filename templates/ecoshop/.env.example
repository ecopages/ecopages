ECOPAGES_BASE_URL=http://localhost:3000
ECOPAGES_HOSTNAME=localhost
ECOPAGES_PORT=3000
ECOPAGES_LOGGER_DEBUG=false

# Shopify Storefront API. Leave both unset to run on the bundled demo catalog.
# Create the public token with the Headless sales channel in Shopify admin; see the README.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional. Defaults to the version pinned in src/lib/commerce/provider.server.ts.
SHOPIFY_API_VERSION=

# Signing secret for the products/* and collections/* webhooks posted to /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=
