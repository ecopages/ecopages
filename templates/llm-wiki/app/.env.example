ECOPAGES_BASE_URL=http://localhost:3333

# Path to the wiki directory containing category subdirectories with .md files.
# Default: ../../../wiki relative to this source module (../wiki from the app directory).
# WIKI_DIR=/path/to/your/wiki

# Path to the sources directory containing raw .md source files.
# Default: ../../../sources relative to this source module (../sources from the app directory).
# SOURCES_DIR=/path/to/your/sources

# Category mode: "auto" (default), "frontmatter", or "directory".
# Auto detects one unambiguous layout; an explicit mode falls back to the other
# layout only when its expected file structure is absent.
# - frontmatter: Category from frontmatter "category" field, flat file structure
# - directory: Category from directory name, subdirectory structure
# WIKI_CATEGORY_MODE=auto

# Optional: category/page slug for the landing page. Default: first sorted page.
# WIKI_HOME_SLUG=app/demo

# Optional: one-way mirror of wiki/, sources/, and schema files into an Obsidian vault.
# OBSIDIAN_VAULT_PATH=/path/to/your/vault
# LLM_WIKI_OBSIDIAN_SUBDIR=llm-wiki

# Optional: enable debug logging for the wiki ingest pipeline.
# LLM_WIKI_DEBUG=true
