{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"rootDirs": ["./src", "./node_modules/@types/ecopages-css-modules"],
		"paths": {
			"@/*": ["./src/*", "./node_modules/@types/ecopages-css-modules/*"]
		}
	},
	"exclude": [".eco"]
}
